---
// src/components/HeaderNav.astro
interface Props {
  shortName: string;
}

const { shortName } = Astro.props;
---

<header id="site-nav" class="nav-container">
  <div class="nav-inner">
    <a href="#" class="nav-brand font-display">
      {shortName}
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="#what-i-am" class="nav-link font-mono link-underlined">What I am</a>
      <a href="#work" class="nav-link font-mono link-underlined">Work</a>
    </nav>
  </div>
</header>

<style>
  .nav-container {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 80;
    background-color: rgba(11, 11, 10, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-hairline);
    transform: translateY(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-container.is-hidden {
    transform: translateY(-100%);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.15rem var(--page-padding-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    font-size: 1.65rem;
    color: var(--color-bone);
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-link {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-link:hover {
    color: var(--color-bone);
  }
</style>

<script>
  (function () {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          if (currentScrollY > lastScrollY && currentScrollY > 90) {
            nav.classList.add('is-hidden');
          } else {
            nav.classList.remove('is-hidden');
          }
          lastScrollY = Math.max(0, currentScrollY);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
