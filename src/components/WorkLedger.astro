---
// src/components/WorkLedger.astro
interface Project {
  id: string;
  index: string;
  title: string;
  summary: string;
  stack: string;
  status: string;
  statusType: string;
  year: string;
  url: string | null;
  bullets: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="work" class="work-section" aria-labelledby="work-heading">
  <div class="work-inner">
    <div class="work-section-header">
      <div class="header-left">
        <span id="work-heading" class="section-label">[ WORK LEDGER ]</span>
        <h2 class="work-title font-display">
          Engineered Systems & Real Deployments
        </h2>
      </div>
      <div class="header-right font-mono">
        <span class="count-badge">{projects.length} Entries Recorded</span>
      </div>
    </div>

    <div class="ledger-container">
      {projects.map((project) => (
        <article class="ledger-card" data-project-id={project.id}>
          <!-- Top Row: Index, Status, Year -->
          <div class="card-meta-bar font-mono">
            <span class="card-index">ENTRY //{project.index}</span>
            <div class="status-badge-wrapper">
              <span class={`status-dot dot-${project.statusType}`} aria-hidden="true"></span>
              <span class="status-text">{project.status}</span>
            </div>
            <span class="card-year">{project.year}</span>
          </div>

          <!-- Main Info -->
          <div class="card-body">
            <div class="card-header-group">
              <h3 class="card-title font-body">
                {project.url ? (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card-title-link"
                  >
                    <span>{project.title}</span>
                    <span class="title-arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span>{project.title}</span>
                )}
              </h3>
              <p class="card-summary font-body">{project.summary}</p>
            </div>

            <!-- Visible Proof Bullets -->
            <div class="card-bullets-block">
              <span class="bullets-label font-mono">KEY DELIVERABLES & IMPACT //</span>
              <ul class="bullet-list font-body">
                {project.bullets.map((bullet) => (
                  <li>
                    <span class="bullet-dash" aria-hidden="true">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Footer of card: Tech Stack Pills + Outbound Link -->
            <div class="card-footer-bar">
              <div class="stack-pills-list font-mono">
                {project.stack.split(',').map((tech) => (
                  <span class="tech-pill">{tech.trim()}</span>
                ))}
              </div>

              {project.url && (
                <div class="card-action">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-visit font-mono"
                  >
                    <span>{project.statusType === 'live' ? 'Visit Live Store' : 'View On GitHub'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work-section {
    padding: clamp(64px, 10vh, 120px) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .work-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding-x);
  }

  .work-section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  @media (min-width: 768px) {
    .work-section-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .work-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--color-bone);
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: -0.5rem;
  }

  .count-badge {
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Ledger Cards */
  .ledger-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .ledger-card {
    background-color: #0e0e0d;
    border: 1px solid var(--color-hairline);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .ledger-card:hover {
    border-color: rgba(236, 231, 220, 0.22);
    background-color: #121110;
  }

  .card-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(236, 231, 220, 0.06);
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }

  .status-badge-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-live {
    background-color: var(--color-amber);
    box-shadow: 0 0 8px var(--color-amber);
  }

  .dot-dev,
  .dot-academic,
  .dot-personal {
    background-color: var(--color-muted);
  }

  .status-text {
    color: var(--color-bone);
    font-weight: 500;
  }

  .card-body {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .card-header-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 500;
    color: var(--color-bone);
    letter-spacing: -0.015em;
  }

  .card-title-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-bone);
    transition: color var(--transition-fast);
  }

  .card-title-link:hover {
    color: var(--color-amber);
  }

  .title-arrow {
    color: var(--color-amber);
    font-size: 0.9em;
  }

  .card-summary {
    font-size: 1.05rem;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: 50rem;
  }

  /* Bullets Block */
  .card-bullets-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: rgba(255, 255, 255, 0.015);
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--color-hairline);
  }

  .bullets-label {
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }

  .bullet-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .bullet-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: #e0dbd0;
    line-height: 1.6;
  }

  .bullet-dash {
    color: var(--color-amber);
    font-family: var(--font-mono);
  }

  /* Footer bar of card */
  .card-footer-bar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 0.75rem;
  }

  @media (min-width: 640px) {
    .card-footer-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .stack-pills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-size: 0.75rem;
    background-color: rgba(236, 231, 220, 0.04);
    border: 1px solid rgba(236, 231, 220, 0.08);
    color: #cfcac0;
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
  }

  .btn-visit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #000;
    background-color: var(--color-amber);
    padding: 0.5rem 1rem;
    border-radius: 2px;
    transition: opacity var(--transition-fast);
    flex-shrink: 0;
  }

  .btn-visit:hover {
    opacity: 0.9;
  }
</style>
